// PackJoyU 业务数据库（Postgres）。内容类数据（产品页、文章）在 Sanity，不在这里。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  EDITOR
}

enum InquiryStatus {
  NEW
  FOLLOWING
  QUOTED
  WON
  INVALID
}

enum InquirySource {
  FORM
  WIZARD
  CART
  CUSTOMIZER
  SAMPLE
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum SampleStatus {
  PENDING
  APPROVED
  REJECTED
  SHIPPED
}

enum ModelStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum Locale {
  en
  ru
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           Role      @default(SALES)
  totpSecret     String? // 双重验证密钥，AES-256-GCM 加密（ADMIN_TOTP_KEY），所有后台账号强制开启
  totpEnabled    Boolean   @default(false) // 绑定确认前为 false，此时不能登录
  totpLastStep   Int? // 上次用过的 TOTP 时间步，防止验证码重放
  recoveryCodes  String[]  @default([]) // 恢复码 argon2id 哈希，用一个删一个
  sessionVersion Int       @default(0) // 加一即让该账号所有会话失效
  disabled       Boolean   @default(false)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  inquiries      Inquiry[] @relation("Assignee")
  createdAt      DateTime  @default(now())
}

// 客户个人信息单独一张表，便于按地区迁移（如俄罗斯数据本地化）和 GDPR 删除
model Contact {
  id        String    @id @default(cuid())
  region    String // 国家代码，如 US / RU / DE
  name      String
  email     String
  company   String?
  phone     String?
  inquiries Inquiry[]
  createdAt DateTime  @default(now())

  @@index([email])
}

model Inquiry {
  id           String           @id @default(cuid())
  ref          String           @unique // 对外询盘编号，如 PJ-2026-0001
  replyToken   String           @unique // 专用回信地址用的随机 token
  contactId    String
  contact      Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  locale       Locale
  source       InquirySource
  status       InquiryStatus    @default(NEW)
  message      String?
  trustScore   Int              @default(50) // 0-100 可信度评分
  trustReasons Json?
  assigneeId   String?
  assignee     User?            @relation("Assignee", fields: [assigneeId], references: [id])
  attribution  Json? // 来源页面、关键词、UTM
  ipCountry    String?
  items        InquiryItem[]
  messages     InquiryMessage[]
  notes        InquiryNote[]
  sample       SampleRequest?
  logoUploads  LogoUpload[]
  autoReplyAt  DateTime? // 自动回复发送时间，用于每邮箱 24 小时一封
  retainUntil  DateTime // GDPR 保留期限
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([assigneeId])
}

// 一条询盘可含多个产品，每个带定制参数
model InquiryItem {
  id          String        @id @default(cuid())
  inquiryId   String
  inquiry     Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  productSlug String // 对应 Sanity 产品
  quantity    Int?
  config      Json? // 颜色、尺寸、材质、logo 文件 key
  designId    String?
  design      SharedDesign? @relation(fields: [designId], references: [id])
}

model InquiryMessage {
  id        String           @id @default(cuid())
  inquiryId String
  inquiry   Inquiry          @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  direction MessageDirection
  subject   String
  bodyHtml  String // 入库前已清洗
  authorId  String?
  createdAt DateTime         @default(now())
}

model InquiryNote {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime @default(now())
}

model SampleRequest {
  id         String       @id @default(cuid())
  inquiryId  String       @unique
  inquiry    Inquiry      @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  status     SampleStatus @default(PENDING)
  trackingNo String?
  reviewedBy String?
  updatedAt  DateTime     @updatedAt
}

// 定制方案短链接 /s/:id，id 为随机字符串，不可递增
model SharedDesign {
  id          String        @id // nanoid(10)
  productSlug String
  config      Json
  items       InquiryItem[]
  createdAt   DateTime      @default(now())
}

model Model3D {
  id           String      @id @default(cuid())
  productSlug  String
  category     String
  sortOrder    Int         @default(0)
  published    Boolean     @default(false)
  status       ModelStatus @default(UPLOADED)
  sourceKey    String // R2 原始文件
  glbKey       String? // 压缩后
  lodKey       String? // gltf-progressive 轻量版本
  posterKey    String? // WebP 封面
  sizeBytes    Int?
  animated     Boolean     @default(false) // 开箱/折叠动画，上限 1.5MB，其余 1MB
  customizable Json? // 可选颜色、尺寸范围
  checks       Json? // [{ key, ok, detail, severity }]，key: format/compress/size/triangles/textures/animation/bounds/lod
  triangles    Int?
  animations   String[]    @default([])
  uploadedBy   String?
  publishedAt  DateTime?
  error        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([published, sortOrder])
  @@index([productSlug])
}

model SiteSetting {
  key   String @id // 如 chat.welcome.en、inquiry.notifyEmail
  value Json
}

// 只增不改
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// 询价 logo 上传。文件私有存储（本地 storage/uploads，以后换 R2），从不提供公开地址。
// 未绑定询盘的上传 1 小时内可绑定，24 小时后由清理任务删除文件和记录。
model LogoUpload {
  id        String   @id // 随机 24 位，不可递增
  path      String // 存储 key，服务端生成
  mime      String // 重新编码后的类型，固定 image/png
  width     Int
  height    Int
  bytes     Int
  inquiryId String?
  inquiry   Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  expiresAt DateTime // 可绑定截止时间

  @@index([inquiryId, createdAt])
}
