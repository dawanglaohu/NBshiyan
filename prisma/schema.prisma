// PackJoyU 业务数据库（Postgres）。内容类数据（产品页、文章）在 Sanity，不在这里。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  EDITOR
}

enum InquiryStatus {
  NEW
  FOLLOWING
  QUOTED
  WON
  INVALID
}

enum InquirySource {
  FORM
  WIZARD
  CART
  CUSTOMIZER
  SAMPLE
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum SampleStatus {
  PENDING
  APPROVED
  REJECTED
  SHIPPED
}

enum ModelStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum Locale {
  en
  ru
  // 多语言第 0 期预留（只追加，不改名、不删、不调顺序）。线上是否开放由 src/lib/server/published-locales.ts 决定，未发布语言接口一律 400。
  es
  de
  fr
  ja
  hi
  ar
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           Role      @default(SALES)
  totpSecret     String? // 双重验证密钥，AES-256-GCM 加密（ADMIN_TOTP_KEY），所有后台账号强制开启
  totpEnabled    Boolean   @default(false) // 绑定确认前为 false，此时不能登录
  totpLastStep   Int? // 上次用过的 TOTP 时间步，防止验证码重放
  recoveryCodes  String[]  @default([]) // 恢复码 argon2id 哈希，用一个删一个
  sessionVersion Int       @default(0) // 加一即让该账号所有会话失效
  disabled       Boolean   @default(false)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime? // 最近一次成功登录（#95 账号管理页显示）
  reactivatedAt  DateTime? // ADMIN 重新启用的时间；闲置天数从 max(lastLoginAt, reactivatedAt, createdAt) 起算（retention cron）
  enrollIssuedAt   DateTime? // #347 绑定窗口起点：重置 2FA 时写入；为空时用 createdAt。起点 + 72 小时后 enroll/confirm 一律拒绝，需管理员重置 2FA
  totpPendingUntil DateTime? // #347/#348 待确认密钥的有效期，同时是再次 enroll 的冷却截止时间（期间不能覆盖待确认密钥）
  totpEnrollFails  Int       @default(0) // #348 当前待确认密钥上、密码已通过时的错码次数；达到上限作废密钥，发新密钥或绑定成功时清零
  enrollTokenHash      String? // #347 方案 A 一次性绑定令牌的 sha256（hex），不存明文。签发（建号 / 重置 2FA / CLI）时覆盖，旧令牌立即失效；confirm 成功时清空
  enrollTokenExpiresAt DateTime? // #347 令牌截止时间 = min(签发后 24 小时, 72 小时绑定窗口截止)；为空或已过期时 enroll/confirm 一律 401 bad_credentials
  inquiries      Inquiry[] @relation("Assignee")
  createdAt      DateTime  @default(now())
}

// 客户个人信息单独一张表，便于按地区迁移（如俄罗斯数据本地化）和 GDPR 删除
model Contact {
  id        String    @id @default(cuid())
  region    String // 国家代码，如 US / RU / DE
  name      String
  email     String
  company   String?
  phone     String?
  /// 规范化邮箱（小写、去 +后缀、Gmail 去点）：隐私导出/删除和自动回复去重按它精确匹配。写入时填，旧数据用 scripts/backfill-normalized-email.ts 回填
  normalizedEmail String?
  inquiries Inquiry[]
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([normalizedEmail])
}

model Inquiry {
  id           String           @id @default(cuid())
  ref          String           @unique // 对外询盘编号，如 PJ-2026-0001
  replyToken   String           @unique // 专用回信地址用的随机 token
  contactId    String
  contact      Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  locale       Locale
  source       InquirySource
  status       InquiryStatus    @default(NEW)
  message      String?
  trustScore   Int              @default(50) // 0-100 可信度评分
  trustReasons Json?
  assigneeId   String?
  assignee     User?            @relation("Assignee", fields: [assigneeId], references: [id])
  attribution  Json? // 来源页面、关键词、UTM
  ipCountry    String?
  items        InquiryItem[]
  messages     InquiryMessage[]
  notes        InquiryNote[]
  sample       SampleRequest?
  logoUploads  LogoUpload[]
  mailMessages MailMessage[] // #74 往来邮件（新表）；旧 InquiryMessage 只读
  autoReplyAt  DateTime? // 自动回复发送时间，用于每邮箱 24 小时一封
  retainUntil  DateTime // GDPR 保留期限
  anonymizedAt DateTime? // 已匿名化（保留期到期 cron 或手动删除），不再重复处理
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([assigneeId])

  @@index([retainUntil, anonymizedAt])
}

// 一条询盘可含多个产品，每个带定制参数
model InquiryItem {
  id          String        @id @default(cuid())
  inquiryId   String
  inquiry     Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  productSlug String // 对应 Sanity 产品
  quantity    Int?
  config      Json? // 颜色、尺寸、材质、logo 文件 key
  notes       String? // 客户对该产品的备注，<= 500 字
  designId    String?
  design      SharedDesign? @relation(fields: [designId], references: [id])
}

model InquiryMessage {
  id        String           @id @default(cuid())
  inquiryId String
  inquiry   Inquiry          @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  direction MessageDirection
  subject   String
  bodyHtml  String // 入库前已清洗
  authorId  String?
  createdAt DateTime         @default(now())
}

model InquiryNote {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime @default(now())
}

model SampleRequest {
  id              String       @id @default(cuid())
  inquiryId       String       @unique
  inquiry         Inquiry      @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  status          SampleStatus @default(PENDING)
  trackingNo      String?
  reviewedBy      String?
  normalizedEmail String? // 去 +后缀、Gmail 去点、小写；用于“每邮箱 30 天 1 次”
  shippingAddress Json? // PII：后台列表脱敏，查看完整地址写审计
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([normalizedEmail, createdAt])
}

// 定制方案短链接 /s/:id，id 为随机字符串，不可递增
model SharedDesign {
  id           String        @id // 随机 16 位（旧数据 10 位），不可递增
  productSlug  String
  category     String? // categoryMeta 的内部 key，用于 /s/:id 的 canonical
  locale       Locale        @default(en)
  config       Json // 经 zod 校验，见 src/lib/server/designs.ts
  logoUploadId String?
  logoUpload   LogoUpload?   @relation(fields: [logoUploadId], references: [id], onDelete: SetNull)
  items        InquiryItem[]
  expiresAt    DateTime? // null = 已被询盘引用，跟随询盘保留期
  createdAt    DateTime      @default(now())

  @@index([expiresAt])
}

model Model3D {
  id           String      @id @default(cuid())
  productSlug  String
  category     String
  sortOrder    Int         @default(0)
  published    Boolean     @default(false)
  status       ModelStatus @default(UPLOADED)
  sourceKey    String // R2 原始文件
  glbKey       String? // 压缩后
  lodKey       String? // gltf-progressive 轻量版本
  posterKey    String? // WebP 封面
  sizeBytes    Int?
  animated     Boolean     @default(false) // 开箱/折叠动画，上限 1.5MB，其余 1MB
  customizable Json? // 可选颜色、尺寸范围
  checks       Json? // [{ key, ok, detail, severity }]，key: format/compress/size/triangles/textures/animation/bounds/lod
  triangles    Int?
  animations   String[]    @default([])
  uploadedBy   String?
  publishedAt  DateTime?
  error        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([published, sortOrder])
  @@index([productSlug])
}

model SiteSetting {
  key   String @id // 如 chat.welcome.en、inquiry.notifyEmail
  value Json
}

// 只增不改
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// 询价 logo 上传。文件私有存储（本地 storage/uploads，以后换 R2），从不提供公开地址。
// 未绑定询盘的上传 1 小时内可绑定，24 小时后由清理任务删除文件和记录。
model LogoUpload {
  id        String         @id // 随机 24 位，不可递增
  path      String // 存储 key，服务端生成
  mime      String // 重新编码后的类型，固定 image/png
  width     Int
  height    Int
  bytes     Int
  inquiryId String?
  inquiry   Inquiry?       @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
  expiresAt DateTime // 可绑定截止时间
  designs   SharedDesign[] // 被未过期方案引用时不清理

  @@index([inquiryId, createdAt])
}

// #350 about / 首页图片（公开资源）。只有 ADMIN 能上传；原图按 magic bytes 判型（jpg/png/webp），sharp 去掉 EXIF/GPS 等元数据，
// 重新编码成两种宽度的 WebP（sm 800、lg 1600，不放大），存 STORAGE_DRIVER 对应的存储（local: UPLOAD_DIR 下 public-assets/），原图不保存。
// 公开地址 /media/<id>-<w>.webp（immutable）。不参与 24 小时清理；只能删除未被 about.images 引用的图片（软删除 + 删文件）。
model PublicAsset {
  id        String    @id // 随机 24 位字母数字，不可递增
  kind      String    @default("about") // 用途，目前只有 about
  smKey     String // 存储 key（服务端生成，.webp）；原图不宽于 800 时与 lgKey 相同
  smWidth   Int
  smHeight  Int
  smBytes   Int
  lgKey     String
  lgWidth   Int
  lgHeight  Int
  lgBytes   Int
  bytes     Int // 上传原图大小（字节）
  sha256    String // 上传原图的 sha256（hex），同一张图重复上传时复用已有记录
  createdBy String? // User.id（不建外键，和 AuditLog.actorId 一样，删用户不影响图片）
  createdAt DateTime  @default(now())
  deletedAt DateTime? // 软删除：公开地址立即 404，文件同时删除
  deletedBy String?

  @@index([kind, deletedAt, createdAt])
  @@index([sha256])
}

// 国际贸易术语（Incoterms 2020）
enum Incoterm {
  EXW
  FCA
  FAS
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP
}

// 产品规格：每个品类一行，category 必须是 categoryMeta.ts 里的 key。所有字段可选，公开接口只返回已填写的字段。
// 字段命名对应 schema.org Product，映射见 docs/API.md。
model CategorySpec {
  category          String     @id
  /// 最小尺寸（mm）：{ l, w, h }
  sizeMin           Json?
  /// 最大尺寸（mm）：{ l, w, h }
  sizeMax           Json?
  /// 材料：{ en, ru }
  material          Json?
  /// 起订量（件）
  moq               Int?
  sampleFeeAmount   Decimal?   @db.Decimal(10, 2)
  sampleFeeCurrency String?
  sampleFree        Boolean?
  leadTimeDaysMin   Int?
  leadTimeDaysMax   Int?
  /// 认证：[{ name, certNo?, url? }]
  certifications    Json?
  tradeTerms        Incoterm[] @default([])
  /// 备注：{ en, ru }
  notes             Json?
  updatedAt         DateTime   @updatedAt
  updatedById       String?
}

// —— #74 后台域名邮箱（backend-plan v4 §3 + §16/§17）。只新增表和枚举（db push additive-only）。——
enum MailDirection {
  INBOUND
  OUTBOUND
}

enum MailStatus {
  QUEUED // §17：超过 MAIL_DAILY_CAP，等下一次重置后自动发送
  SENDING
  SENT
  FAILED
  RECEIVED
  UNASSIGNED
  IGNORED
}

enum DeliveryStatus {
  UNKNOWN
  BOUNCED // 第 2 阶段
}

model MailMessage {
  id               String         @id @default(cuid())
  direction        MailDirection
  status           MailStatus
  inquiryId        String? // null = 未归类（仅入站）
  inquiry          Inquiry?       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  messageId        String?        @unique // RFC 5322 Message-ID。出站：<sendKey@REPLY_DOMAIN>（§16 由我们生成）；入站：原信头
  sendKey          String?        @unique // 出站：randomId(24)，创建时生成一次，全程不变（M5）
  inReplyTo        String?
  references       String? // 截断 2KB
  remoteMailId     String?        @unique // 入站：Worker 邮件 id，幂等键（§4）
  idemKey          String?        @unique // 出站：HMAC(userId + Idempotency-Key)，同一键不重复建信
  fromAddr         String
  fromHash         String? // 入站发件人 emailHash，供隐私删除匹配未归类信
  toAddr           String
  subject          String
  bodyHtml         String // 入站：白名单净化后；出站：纯文本转义
  bodyText         String
  hasRemoteImages  Boolean        @default(false)
  authSpf          String?
  authDkim         String?
  authDmarc        String?
  senderVerified   Boolean? // 只供 UI 提示，不参与归属（§4.5）
  authorId         String? // 出站管理员
  errorCode        String? // 出站失败原因码 / daily_cap_deferred
  retryable        Boolean        @default(false)
  attempts         Int            @default(0) // 出站：实际开始 SMTP 会话的次数
  retryCount       Int            @default(0) // 出站：手动重试次数，上限 5
  lockedUntil      DateTime? // 出站发送租约（M5）
  requestStartedAt DateTime? // 出站：已开始 SMTP 会话（不为空即“可能已送达”边界）
  capDay           DateTime? // §17：占用了哪一个发信日的名额（该日窗口起点，UTC）
  deferredUntil    DateTime? // §17：daily_cap_deferred 时的预计发送时间
  deliveryStatus   DeliveryStatus @default(UNKNOWN)
  redactedAt       DateTime?
  flags            String[]       @default([]) // too_large | auto | bounce | attachment_rejected | parse_error
  sentAt           DateTime?
  receivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([inquiryId, createdAt])
  @@index([status, createdAt])
  @@index([direction, capDay])
  @@index([status, deferredUntil])
  @@index([fromHash])
}
