    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "aws4fetch": "^1.0.20",
    "idb-keyval": "^6.2.2",
    "next": "~15.5.27",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.3.9",
