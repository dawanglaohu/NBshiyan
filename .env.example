# 本地测试步骤见 docs/LOCAL-TESTING.md
# 复制为 .env.local；真实值只放 Vercel 环境变量，不要提交
DATABASE_URL=
RESEND_API_KEY=
INQUIRY_NOTIFY_EMAIL=
# 本地/预览用 Cloudflare 官方测试密钥（总是通过）；正式环境换成真实密钥
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_TAWK_PROPERTY_ID=
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
AUTH_SECRET=            # openssl rand -base64 32
AUTH_URL=              # Auth.js 站点地址，如 https://packjoyu.com
APP_ORIGIN=            # 可选：反向代理后对外域名与请求 origin 不一致时，用于后台 Origin 校验
ADMIN_TOTP_KEY=        # 2FA 密钥加密用，32 字节：openssl rand -base64 32；更换会导致已绑定的 2FA 失效
REPLY_DOMAIN=          # 可选，客户回信地址域名
MAIL_FROM=
# 客户邮件模板（#122）里显示的联系方式，都是公开信息，不填则模板里不显示该项
CONTACT_REPLY_TIME=    # 承诺回复时间，如 24h
CONTACT_EMAIL=         # 对外联系邮箱，如 sales@example.com
CONTACT_WHATSAPP=      # WhatsApp 号码，国际格式，如 +8613800000000
BEHIND_CLOUDFLARE=

# Tawk.to 在线客服（不填则悬浮按钮跳到联系页）
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=
# 可选：俄语专用 widget
NEXT_PUBLIC_TAWK_WIDGET_ID_RU=

# logo 上传
CRON_SECRET=
UPLOAD_DIR=          # 可选，默认 ./storage/uploads

# 搜索平台站点验证（上线后填写）
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
