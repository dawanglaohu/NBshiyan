# 本地测试步骤见 docs/LOCAL-TESTING.md
# 复制为 .env.local；真实值只放 Vercel 环境变量，不要提交
DATABASE_URL=
RESEND_API_KEY=        # 在 Resend 后台建 Sending access（只能发信）的 key，只放环境变量
INQUIRY_NOTIFY_EMAIL=
ADMIN_ALERT_EMAIL=     # 可选，后台告警（发信失败、定时任务失败、账号锁定）收件人；不填则发给 INQUIRY_NOTIFY_EMAIL
# 本地/预览用 Cloudflare 官方测试密钥（总是通过）；正式环境换成真实密钥
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
SANITY_PROJECT_ID=        # Sanity 项目 ID；留空则使用仓库内静态内容
SANITY_DATASET=production
SANITY_API_READ_TOKEN=    # 仅 Viewer 权限；公开数据集可留空
SANITY_REVALIDATE_SECRET=
AUTH_SECRET=            # openssl rand -base64 32；限流 key 里的邮箱 HMAC 也由它派生（#74）
AUTH_URL=              # Auth.js 站点地址，如 https://packjoyu.com
APP_ORIGIN=            # 可选：反向代理后对外域名与请求 origin 不一致时，用于后台 Origin 校验
PROD_DATABASE_HOST=     # 生产库主机名，逗号分隔，支持 *.example.com；pnpm admin:create 遇到 DATABASE_URL 命中时拒绝运行（CI 里配置）
ADMIN_SEED_TOTP_SECRET= # CI only, random per run, never commit。base32，pnpm admin:create 用来预置 2FA；生产环境设置会报错退出
ADMIN_TOTP_KEY=        # 2FA 密钥加密用，32 字节：openssl rand -base64 32；更换会导致已绑定的 2FA 失效
REPLY_DOMAIN=          # 可选，客户回信地址域名
MAIL_FROM=
# 客户邮件模板（#122）里显示的联系方式，都是公开信息，不填则模板里不显示该项
CONTACT_REPLY_TIME=    # 承诺回复时间（小时，1–720，如 24 或 24h）；不设置则客户邮件不写回复时长
CONTACT_EMAIL=         # 对外联系邮箱，如 sales@example.com
CONTACT_WHATSAPP=      # WhatsApp 号码，国际格式，如 +8613800000000
BEHIND_CLOUDFLARE=

# Tawk.to 在线客服（不填则悬浮按钮跳到联系页）
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=
# 可选：俄语专用 widget
NEXT_PUBLIC_TAWK_WIDGET_ID_RU=

# logo 上传
CRON_SECRET=
MIDDLEWARE_PROBE_SECRET= # 可选，>= 32 字节随机值（openssl rand -base64 32）；middleware 探测 HEAD /api/designs/:id 时带上，用于按客户端 IP 分桶限流；不足 32 字节会被忽略
UPLOAD_DIR=          # 可选，STORAGE_DRIVER=local 时的目录，默认 ./storage/uploads

# 私有文件存储（logo、模型）：local（默认）或 r2。R2 桶必须私有，不开公开访问
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=         # 可选，默认 https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# 限流存储：memory（默认，单实例）或 upstash（多实例共享，生产用）
RATE_LIMIT_STORE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 搜索平台站点验证（上线后填写）
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# 数据保留（天），见 docs/data-retention.md
DESIGN_TTL_DAYS=180
DESIGN_GRACE_DAYS=90
SAMPLE_COUNTER_RETAIN_DAYS=30
AUDIT_RETAIN_DAYS=365
INQUIRY_RETAIN_DAYS=730
# 清理任务每次运行的最多处理条数（每批 500）
RETENTION_MAX_PER_RUN=20000
RETENTION_RUN_DEADLINE_MS=    # 整次定时清理共用的截止时间（毫秒，默认 270000，范围 10000–280000）；平台函数时限 60s 时设 50000，见 launch-runbook.md。旧的 RETENTION_STEP_BUDGET_MS 已废弃
# 隐私导出/删除审计里邮箱 HMAC 的密钥，至少 32 字节：openssl rand -base64 32。生产必填（未设置时隐私接口 503）；与 AUTH_SECRET 分开，轮换 AUTH_SECRET 不影响历史哈希
PRIVACY_HASH_SECRET=

# 可选：探测用的固定 origin，默认 NEXT_PUBLIC_SITE_URL；都不设则不探测
SHORTLINK_PROBE_ORIGIN=
TRUSTED_PROXY_HOPS=

# IndexNow（Yandex/Bing 主动推送，Refs #74）。8–128 位，只能用 a-z A-Z 0-9 -；生成：openssl rand -hex 16
# 只有在 APP_ENV=production 且 RATE_LIMIT_STORE=upstash（用于 10 分钟去重）时才会启用；不设就整体关闭
INDEXNOW_KEY=

# 运行环境：只有 APP_ENV=production 才按正式环境处理（允许收录、IndexNow、生产配置自检）；预览/本地留空，默认非生产
APP_ENV=
# 正式站点地址（不带结尾斜杠）
# NEXT_PUBLIC_SITE_URL=https://geiom.com
