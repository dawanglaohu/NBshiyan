    "output": "Auth.js原redirect/CSRF/session协议；session可增sid非凭据摘要与effectiveExpiresAt",
    "permissions": "Auth.js，失败不透露账号方式"
  },
  {
    "method": "POST",
    "path": "/api/auth-admin/enroll",
    "input": "现有email/password/token",
