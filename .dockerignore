# Never send secrets, keys or VCS data into the build context
.env
.env.*
!.env.example
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/id_rsa*
.git
.github
node_modules
.next
storage
# Root uploads/ only. Docker strips the leading slash, so this is that one directory.
# Do not write **/uploads: it also drops src/app/api/uploads and src/app/api/admin/uploads.
/uploads
deploy
e2e
tests
playwright-report
test-results
reports
design
docs
*.log
