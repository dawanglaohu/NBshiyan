# DO NOT copy this file to .env as-is. Ops creates the real env file on the server (root:root 600) with init-secrets.sh,
# and Ryan fills the [RYAN] keys there himself. Every value line here is just "KEY=" (empty, no inline comment):
# docker compose env_file has no reliable inline-comment support, so "KEY=  # note" could become the value "# note".
# App runtime env file (root:root 600 on the host; path given by NBSHIYAN_APP_ENV_FILE). TEMPLATE ONLY: no values here, ever.
# Legend:
#   [GEN]    generated on the server by init-secrets (openssl rand), never leaves the server, never printed
#   [RYAN]   Ryan supplies the value himself (private chat or he types it on the server); never in a group / to a bot
#   [FIXED]  fixed non-secret value written by ops (value given in the comment)
#   [PUBLIC] non-secret, also needed at BUILD time (inlined into the client bundle / static pages)
#   SECRET   = must not be logged, echoed, pasted or committed
# REQ = required by prod-env-check.ts when APP_ENV=production (missing → server.js exits at start via src/instrumentation.ts)

# ---------- environment ----------
# APP_ENV: [FIXED][PUBLIC] REQ production. Also a build arg (noindex headers + canonical are baked at build)
APP_ENV=
# NODE_ENV: [FIXED] production (compose also forces it)
NODE_ENV=
# NEXT_PUBLIC_SITE_URL: [FIXED][PUBLIC] REQ https://geiom.com (no trailing slash)
NEXT_PUBLIC_SITE_URL=
# AUTH_URL: [FIXED] REQ https://geiom.com
AUTH_URL=
# APP_ORIGIN: [FIXED] REQ https://geiom.com (= NEXT_PUBLIC_SITE_URL origin). Under standalone the request's own origin is
#   http://0.0.0.0:3000 regardless of the Host nginx passes, so without it admin POSTs get 403; startup check exits 1 if missing
APP_ORIGIN=
# NEXT_PUBLIC_ADMIN_API: [FIXED][PUBLIC] REQ http
NEXT_PUBLIC_ADMIN_API=

# ---------- database (local container, compose service "postgres") ----------
# DATABASE_URL: [GEN] SECRET REQ postgresql://nbshiyan:<pg_password>@postgres:5432/nbshiyan?schema=public
#   internal docker network, no TLS; password = secrets/pg_password
DATABASE_URL=
# PROD_DATABASE_HOST: do NOT set on the server (guard is only in the CI/local `admin:seed`; admin-create.mjs has none)

# ---------- auth / secrets ----------
# AUTH_SECRET: [GEN] SECRET REQ openssl rand -base64 32
AUTH_SECRET=
# ADMIN_TOTP_KEY: [GEN] SECRET REQ openssl rand -base64 32 (exactly 32 bytes). NEVER rotate: rotating breaks every bound 2FA
ADMIN_TOTP_KEY=
# PRIVACY_HASH_SECRET: [GEN] SECRET REQ ≥32 bytes, openssl rand -base64 48. Do not rotate together with AUTH_SECRET
PRIVACY_HASH_SECRET=
# CRON_SECRET: [GEN] SECRET REQ ≥32 chars, openssl rand -base64 48 (host cron calls the endpoint from inside the container)
CRON_SECRET=
# MIDDLEWARE_PROBE_SECRET: [GEN] SECRET ≥32 bytes (launch-checklist requires it in prod)
MIDDLEWARE_PROBE_SECRET=
# EDGE_AUTH_SECRET: [GEN, already exists on the server] SECRET REQ (runtime only) ≥32 bytes. MUST be byte-identical to the value
#   the reverse-proxy include file; verify with cmp/sha256 only, never cat/echo
EDGE_AUTH_SECRET=
# SHORTLINK_PROBE_ORIGIN: [FIXED] proposed http://127.0.0.1:3000 (probe stays inside the container, see Q-PROBE); else empty
SHORTLINK_PROBE_ORIGIN=

# ---------- rate limit (Redis + Upstash-compatible REST proxy, see §11.4) ----------
# RATE_LIMIT_STORE: [FIXED][PUBLIC-at-build] REQ upstash
RATE_LIMIT_STORE=
# UPSTASH_REDIS_REST_URL: [FIXED] REQ https://redis-rest:8443  (srh-tls, internal CA trusted via NODE_EXTRA_CA_CERTS)
UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN: [GEN] SECRET REQ = SRH_TOKEN in secrets/srh.env
UPSTASH_REDIS_REST_TOKEN=

# ---------- private file storage (Ryan: LOCAL) ----------
# STORAGE_DRIVER: [FIXED] REQ local  (compose also forces it)
STORAGE_DRIVER=
# UPLOAD_DIR: [FIXED] REQ /data/uploads — absolute, writable, NOT under public/ or .next/ (startup check exits 1 otherwise);
#   compose forces it and mounts the host uploads dir there (owner uid 1001)
UPLOAD_DIR=
# R2_* not used with local storage

# ---------- mail (#315: Gmail SMTP via nodemailer; Resend removed — no RESEND_API_KEY) ----------
# MAIL_SEND_ADAPTER: [FIXED] REQ smtp (anything else → refuses to start)
MAIL_SEND_ADAPTER=
# SMTP_HOST: [FIXED] REQ smtp.gmail.com
SMTP_HOST=
# SMTP_PORT: [FIXED] REQ 465 (implicit TLS) or 587 (STARTTLS enforced); no other port
SMTP_PORT=
# SMTP_USER: [RYAN] SECRET REQ (runtime only) sending Gmail address
SMTP_USER=
# SMTP_PASS: [RYAN] SECRET REQ (runtime only) Gmail app password
SMTP_PASS=
# MAIL_FROM: [RYAN] REQ PackJoyU <that Gmail address>; must NOT be a REPLY_DOMAIN address
MAIL_FROM=
# REPLY_DOMAIN: [FIXED] geiom.com (Reply-To reply+<token>@geiom.com; empty → admin "send" disabled)
REPLY_DOMAIN=
# MAIL_WEBHOOK_SECRET: [GEN] SECRET REQ (runtime only) ≥32 random bytes, generated on the server, only in this file.
#   NOT configured on the inbound Worker until Q7 is approved (Email Routing stays as is)
MAIL_WEBHOOK_SECRET=
# MAIL_DAILY_CAP: [FIXED] 450
MAIL_DAILY_CAP=
# MAIL_DAILY_CAP_RESET: [FIXED] 00:00 (UTC, HH:MM)
MAIL_DAILY_CAP_RESET=
# MAIL_RATE_ADMIN_PER_HOUR: [FIXED] 30
MAIL_RATE_ADMIN_PER_HOUR=
# MAIL_RATE_GLOBAL_PER_HOUR: [FIXED] 200
MAIL_RATE_GLOBAL_PER_HOUR=
# INQUIRY_NOTIFY_EMAIL: [RYAN] REQ
INQUIRY_NOTIFY_EMAIL=
# ADMIN_ALERT_EMAIL: [RYAN] optional
ADMIN_ALERT_EMAIL=
# CONTACT_EMAIL: [RYAN] optional (public)
CONTACT_EMAIL=
# CONTACT_WHATSAPP: [RYAN] optional (public)
CONTACT_WHATSAPP=
# CONTACT_REPLY_TIME: [RYAN] optional (Q16)
CONTACT_REPLY_TIME=
# NEXT_PUBLIC_ADMIN_MAIL: [PUBLIC, build arg] empty until mail goes live, then http (never mock). Inlined at build
NEXT_PUBLIC_ADMIN_MAIL=
# NODE_TLS_REJECT_UNAUTHORIZED must never be 0

# ---------- Turnstile ----------
# TURNSTILE_SECRET_KEY: [RYAN] SECRET REQ real key (test key 1x000…AA is rejected)
TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY: [RYAN][PUBLIC] REQ at BUILD (build-args.env) and runtime: real site key for geiom.com; empty or the Cloudflare test key fails `next build`
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------- Tawk.to (public) ----------
# NEXT_PUBLIC_TAWK_PROPERTY_ID: [RYAN][PUBLIC] optional
NEXT_PUBLIC_TAWK_PROPERTY_ID=
# NEXT_PUBLIC_TAWK_WIDGET_ID: [RYAN][PUBLIC] optional
NEXT_PUBLIC_TAWK_WIDGET_ID=
# NEXT_PUBLIC_TAWK_WIDGET_ID_RU: [RYAN][PUBLIC] optional
NEXT_PUBLIC_TAWK_WIDGET_ID_RU=

# ---------- Sanity (optional; empty = static content in repo) ----------
# SANITY_PROJECT_ID: [RYAN][PUBLIC-at-build] optional
SANITY_PROJECT_ID=
# SANITY_DATASET: [RYAN][PUBLIC-at-build] production
SANITY_DATASET=
# SANITY_API_READ_TOKEN: [RYAN] SECRET optional (Viewer; empty for a public dataset)
SANITY_API_READ_TOKEN=
# SANITY_REVALIDATE_SECRET: [RYAN] SECRET optional (Bearer for /api/sanity/revalidate; unset → the webhook is rejected).
#   The code reads SANITY_REVALIDATE_SECRET; "SANITY_WEBHOOK_SECRET" is only the smoke-test message, not a variable.
SANITY_REVALIDATE_SECRET=

# ---------- SEO (public) ----------
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION: [RYAN/SEO][PUBLIC]
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_YANDEX_VERIFICATION: [RYAN/SEO][PUBLIC]
NEXT_PUBLIC_YANDEX_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION: [RYAN/SEO][PUBLIC]
NEXT_PUBLIC_BING_VERIFICATION=
# NEXT_PUBLIC_FAQ_JSONLD_ENABLED: [PUBLIC] leave empty at launch
NEXT_PUBLIC_FAQ_JSONLD_ENABLED=
# INDEXNOW_KEY: [GEN] 8–128 [A-Za-z0-9-], openssl rand -hex 16 (public by design: served as /<key>.txt)
INDEXNOW_KEY=
# CATALOG_STRICT_API: leave empty at launch
CATALOG_STRICT_API=

# ---------- retention (defaults are fine; self-host has no 60 s function limit) ----------
DESIGN_TTL_DAYS=
DESIGN_GRACE_DAYS=
SAMPLE_COUNTER_RETAIN_DAYS=
AUDIT_RETAIN_DAYS=
INQUIRY_RETAIN_DAYS=
RETENTION_MAX_PER_RUN=
RETENTION_RUN_DEADLINE_MS=
# RETENTION_DRY_RUN: set 1 only for the pre-launch dry run, then remove
RETENTION_DRY_RUN=
ADMIN_INACTIVE_DAYS=

# ---------- MUST NOT be set in production ----------
# RESEND_API_KEY, R2_* incl. R2_ENDPOINT (local storage), ADMIN_CREATE_PASSWORD (prod refuses it; hidden prompt/stdin only), SEO_AUDIT_MOCK, PROD_DATABASE_HOST, NODE_TLS_REJECT_UNAUTHORIZED=0, ADMIN_SEED_TOTP_SECRET, TURNSTILE_VERIFY_URL, NEXT_PUBLIC_*_MOCK, BEHIND_CLOUDFLARE, TRUSTED_PROXY_HOPS, VERCEL_ENV

# =====================================================================
# Side files under ${NBSHIYAN_DATA_DIR}/secrets (dir 700 root):
#   pg_password    [GEN] SECRET  400 uid 70        (postgres POSTGRES_PASSWORD_FILE)
#   migrate.env    [GEN] SECRET  600 root          DATABASE_URL=… only (used by the one-off migrate container)
#   redis.conf     [GEN] SECRET  640 root:1000     requirepass <gen, separate from SRH_TOKEN>; maxmemory 48mb; maxmemory-policy allkeys-lru; save ""; appendonly no
#   srh.env        [GEN] SECRET  600 root          SRH_MODE=env, SRH_TOKEN=<= UPSTASH_REDIS_REST_TOKEN>, SRH_CONNECTION_STRING=redis://:<redis pw>@redis:6379
# ${NBSHIYAN_DATA_DIR}/internal-tls: ca.crt (nameConstraints permitted;DNS:redis-rest), redis-rest.crt, redis-rest.key (640 root:101).
#   The CA private key is deleted right after signing (re-issue = new CA + restart app/srh-tls).
# Build: NO env file. Only public build args (APP_ENV, NEXT_PUBLIC_*, SANITY_PROJECT_ID/DATASET), see Dockerfile.
